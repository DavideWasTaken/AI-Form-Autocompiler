{
  "manifest_version": 3,
  "name": "AI Form Autocompiler",
  "version": "2.1.0",
  "minimum_chrome_version": "138",
  "description": "Describe what to fill. OpenAI or Groq generates JavaScript for the current web page.",
  "permissions": ["activeTab", "scripting", "storage", "userScripts"],
  "host_permissions": ["https://api.openai.com/*", "https://api.groq.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
